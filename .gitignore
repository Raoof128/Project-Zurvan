# Zurvan local/private state
.zurvan/
*.local.json
*.secret.json
.env
.env.*
!.env.example

# Zurvan evidence bundles (never commit packs containing raw excerpts)
evidence-packs/
reports/

# Local snapshots/backups may contain private wiki data
dist/snapshots/
dist/backups/

# Raw sources are private by default
raw/
!raw/.gitkeep

# Local databases may expose private knowledge
data/*.sqlite
data/*.db
# Derived float32 vector sidecar for the search index (see scripts/vector_cache.py)
data/*.vectors.npy
data/*.vectors.json
data/embeddings/
!data/.gitkeep

# Graph exports are regenerated from the full (private) knowledge base and
# embed source/AutoConcept node titles & paths — never commit them.
data/graph_export.md
data/graph_export.dot
data/image_manifest.json

# Python/local noise
.venv/
__pycache__/
.pytest_cache/
# pytest-cov artefacts (per-host suffixed files from parallel/subprocess runs)
.coverage
.coverage.*
htmlcov/
coverage.json
.DS_Store

# Ingested external knowledge (private — generated from other projects)
# ingest.py produces <original-filename>.<ext>.md stubs in these dirs.
# Ignore EVERY file, not just *.md: a repair/edit leaves siblings like
# <page>.md.pre-repair.bak, which *.md does not match, so the full text of a
# private source page became committable on a public remote.
wiki/sources/*
!wiki/sources/.gitkeep
# Case-folded globs. gitignore matching is CASE-SENSITIVE, but the CLI writes
# lowercase `claim-<id>.md` while these rules were spelled `Claim-*`. That only
# ever matched because macOS is case-insensitive; on Linux or in CI every
# CLI-written claim — each quoting a private source verbatim — became
# trackable. Claims are ignored wholesale for the same reason as sources.
wiki/claims/*
!wiki/claims/.gitkeep
wiki/concepts/[Aa]uto[Cc]oncept-*.md

# Zurvan MCP knowledge nodes (written by zurvan_remember)
wiki/[Nn]ote-*.md

# Obsidian auto-generated session state (not config)
.obsidian/workspace.json
.obsidian/appearance.json
*.canvas

# Auto-generated nav index + activity log — these enumerate ingested (private)
# source/claim/concept filenames, so they must never be tracked or pushed.
# Regenerated locally by `zurvan index rebuild`; kept out of git entirely.
wiki/index.md
# Open questions that do not declare a public project (see scripts/question_routing.py)
wiki/open-questions.private.md
# Sharded source index — lists private wiki/sources/ page names
wiki/index/
wiki/log.md

# Local private-project veto list for public_repo_guard (never publish these names)
.private-projects

# ── The knowledge base is PRIVATE data. Nothing under wiki/ is tracked. ──────
# Per Raouf (2026-09-15): the Zurvan CODE lives in git; the data inside Zurvan
# does not "go anywhere". Every page, note, decision, claim, concept, summary,
# digest, session and trace is private. The targeted rules above are kept as the
# record of which directories leaked and why (sources, claims, the index, the
# log); this is the blanket that makes a new directory private by default rather
# than private only once someone remembers to add a rule.
#
# Only .gitkeep markers remain tracked, so a fresh clone still has the directory
# skeleton the writers expect — they do not create their own parents.
wiki/**
!wiki/**/
!wiki/**/.gitkeep

# Evaluation instrument cleartext is local-only (~/.zurvan/instruments/).
# Tracking it would violate Boundary INSTRUMENT -> PUBLIC_ARTIFACT, so the
# scanner could not be enabled against this repo. eval/*.manifest.json carries
# the count and digest so integrity survives a clone.
eval/search_gold.jsonl

# Root-level sources/ holds ingested private documents (legal, personal,
# client). Untracked is not enough — `git add -A` would stage it. Same rule as
# wiki/sources/: private by default, never by remembering.
sources/

# Derived SQLite state and rebuild leftovers.
data/*.sqlite-journal
data/*.sqlite.prev
