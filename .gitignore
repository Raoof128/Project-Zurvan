# Zurvan local/private state
.zurvan/
*.local.json
*.secret.json
.env
.env.*
!.env.example

# Zurvan evidence bundles (never commit packs containing raw excerpts)
evidence-packs/
reports/

# Local snapshots/backups may contain private wiki data
dist/snapshots/
dist/backups/

# Raw sources are private by default
raw/
!raw/.gitkeep

# Local databases may expose private knowledge
data/*.sqlite
data/*.db
data/embeddings/
!data/.gitkeep

# Graph exports are regenerated from the full (private) knowledge base and
# embed source/AutoConcept node titles & paths — never commit them.
data/graph_export.md
data/graph_export.dot
data/image_manifest.json

# Python/local noise
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Ingested external knowledge (private — generated from other projects)
# ingest.py produces <original-filename>.<ext>.md stubs in these dirs
wiki/sources/*.md
wiki/claims/Claim-*.md
wiki/concepts/AutoConcept-*.md

# Zurvan MCP knowledge nodes (written by zurvan_remember)
wiki/note-*.md

# Obsidian auto-generated session state (not config)
.obsidian/workspace.json
.obsidian/appearance.json
*.canvas

# Auto-generated nav index + activity log — these enumerate ingested (private)
# source/claim/concept filenames, so they must never be tracked or pushed.
# Regenerated locally by `zurvan index rebuild`; kept out of git entirely.
wiki/index.md
wiki/log.md
