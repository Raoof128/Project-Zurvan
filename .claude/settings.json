{
  "env": {
    "ZURVAN_EMBED_PROVIDER": "sentence_transformers",
    "ZURVAN_EMBED_MODEL": "all-MiniLM-L6-v2"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/scripts/cli.py\" agent prime --fix-stale"
          }
        ]
      }
    ]
  }
}
