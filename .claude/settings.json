{
  "env": {
    "ZURVAN_EMBED_PROVIDER": "sentence_transformers",
    "ZURVAN_EMBED_MODEL": "all-MiniLM-L6-v2"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONPATH=\"$CLAUDE_PROJECT_DIR\" python \"$CLAUDE_PROJECT_DIR/scripts/cli.py\" agent prime"
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Read(//Users/zurvaneval/**)",
      "Edit(//Users/zurvaneval/**)",
      "Read(//Users/zurvaneval)",
      "Bash(*/Users/zurvaneval*)",
      "Read(//Library/ZurvanEval/corpus/**)",
      "Edit(//Library/ZurvanEval/corpus/**)",
      "Read(//Library/ZurvanEval/corpus)",
      "Bash(*/Library/ZurvanEval/corpus*)",
      "Read(//Library/ZurvanEval/stage/**)",
      "Edit(//Library/ZurvanEval/stage/**)",
      "Read(//Library/ZurvanEval/stage)",
      "Bash(*/Library/ZurvanEval/stage*)",
      "Read(//Users/zurvancandidate/**)",
      "Edit(//Users/zurvancandidate/**)",
      "Read(//Users/zurvancandidate)",
      "Bash(*/Users/zurvancandidate*)"
    ]
  }
}
